{
  "manifest_version": 1,
  "type": "device",
  "name": "Audiobookshelf",
  "description": {
    "en": "Follow who listens to what on your Audiobookshelf server and react to it in your scenes.",
    "fr": "Suivez qui écoute quoi sur votre serveur Audiobookshelf et réagissez-y dans vos scènes.",
    "de": "Verfolge, wer was auf deinem Audiobookshelf-Server hört, und reagiere in Szenen darauf.",
    "es": "Siga quién escucha qué en su servidor Audiobookshelf y reaccione en sus escenas."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-audiobookshelf:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-audiobookshelf/main/cover.png",
  "categories": ["multimedia"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Connect to your Audiobookshelf server",
        "fr": "Connexion à votre serveur Audiobookshelf",
        "de": "Verbindung zu deinem Audiobookshelf-Server",
        "es": "Conexión a su servidor Audiobookshelf"
      },
      "description": {
        "en": "Enter the address of the server (for example http://192.168.1.20:13378) and an API key of an administrator: in Audiobookshelf, Settings > API Keys > Add API Key, for an admin user. Before version 2.26, use the API token of an admin user (Settings > Users).",
        "fr": "Indiquez l'adresse du serveur (par exemple http://192.168.1.20:13378) et une clé d'API d'administrateur : dans Audiobookshelf, Paramètres > Clés API > Ajouter, pour un utilisateur admin. Avant la version 2.26, utilisez le jeton d'API d'un admin (Paramètres > Utilisateurs).",
        "de": "Gib die Adresse des Servers (zum Beispiel http://192.168.1.20:13378) und einen API-Schlüssel eines Administrators ein: in Audiobookshelf unter Einstellungen > API-Schlüssel > Hinzufügen, für einen Admin. Vor Version 2.26 nimm das API-Token eines Admins (Einstellungen > Benutzer).",
        "es": "Introduzca la dirección del servidor (por ejemplo http://192.168.1.20:13378) y una clave de API de administrador: en Audiobookshelf, Ajustes > Claves API > Añadir, para un usuario admin. Antes de la versión 2.26, use el token de API de un admin (Ajustes > Usuarios)."
      },
      "links": [
        {
          "url": "https://audiobookshelf.org/docs/documentation/server-management/api-keys/",
          "label": {
            "en": "Audiobookshelf API keys",
            "fr": "Clés d'API d'Audiobookshelf",
            "de": "API-Schlüssel von Audiobookshelf",
            "es": "Claves de API de Audiobookshelf"
          }
        }
      ]
    },
    {
      "key": "server_url",
      "type": "string",
      "label": {
        "en": "Server URL",
        "fr": "URL du serveur",
        "de": "Server-URL",
        "es": "URL del servidor"
      },
      "description": {
        "en": "Address of the server, port included (13378 for the Docker image, often 80). An https address behind a reverse proxy works too.",
        "fr": "Adresse du serveur, port inclus (13378 pour l'image Docker, souvent 80). Une adresse https derrière un reverse proxy fonctionne aussi.",
        "de": "Adresse des Servers mit Port (13378 beim Docker-Image, oft 80). Eine https-Adresse hinter einem Reverse Proxy funktioniert ebenfalls.",
        "es": "Dirección del servidor, puerto incluido (13378 para la imagen Docker, a menudo 80). También funciona una dirección https detrás de un proxy inverso."
      },
      "placeholder": {
        "en": "http://192.168.1.20:13378",
        "fr": "http://192.168.1.20:13378",
        "de": "http://192.168.1.20:13378",
        "es": "http://192.168.1.20:13378"
      },
      "required": true
    },
    {
      "key": "api_key",
      "type": "secret",
      "label": {
        "en": "API key (administrator)",
        "fr": "Clé d'API (administrateur)",
        "de": "API-Schlüssel (Administrator)",
        "es": "Clave de API (administrador)"
      },
      "required": true
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Listening refresh",
        "fr": "Rafraîchissement des écoutes",
        "de": "Aktualisierung der Wiedergaben",
        "es": "Actualización de las escuchas"
      },
      "description": {
        "en": "How often the open listening sessions are read. Libraries, users and progress are read every 5 minutes.",
        "fr": "Fréquence de lecture des sessions d'écoute ouvertes. Bibliothèques, utilisateurs et progression sont lus toutes les 5 minutes.",
        "de": "Wie oft die offenen Wiedergabesitzungen gelesen werden. Bibliotheken, Benutzer und Fortschritt werden alle 5 Minuten gelesen.",
        "es": "Frecuencia de lectura de las sesiones de escucha abiertas. Bibliotecas, usuarios y progreso se leen cada 5 minutos."
      },
      "required": false,
      "default": "30",
      "options": [
        {
          "value": "15",
          "label": {
            "en": "15 seconds",
            "fr": "15 secondes",
            "de": "15 Sekunden",
            "es": "15 segundos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 seconds",
            "fr": "30 secondes",
            "de": "30 Sekunden",
            "es": "30 segundos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "display": "radio",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms",
        "de": "Sprache der Namen",
        "es": "Idioma de los nombres"
      },
      "description": {
        "en": "Language of the feature names and of the texts of the scene actions. Names are set when a device is created: to rename them after a change, delete and re-add the device.",
        "fr": "Langue des noms de fonctionnalités et des textes des actions de scène. Les noms sont fixés à la création d'un appareil : pour les renommer après un changement, supprimez puis rajoutez l'appareil.",
        "de": "Sprache der Funktionsnamen und der Texte der Szenenaktionen. Die Namen werden beim Erstellen eines Geräts festgelegt: Um sie nach einer Änderung umzubenennen, lösche das Gerät und füge es erneut hinzu.",
        "es": "Idioma de los nombres de las funcionalidades y de los textos de las acciones de escena. Los nombres se fijan al crear un dispositivo: para cambiarlos, elimine el dispositivo y vuelva a añadirlo."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Reads the server now and reports what it finds.",
        "fr": "Lit le serveur maintenant et indique ce qu'il trouve.",
        "de": "Liest den Server sofort und meldet, was er findet.",
        "es": "Lee el servidor ahora e indica lo que encuentra."
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "listening_started",
      "label": {
        "en": "Listening started",
        "fr": "Écoute démarrée",
        "de": "Wiedergabe gestartet",
        "es": "Escucha iniciada"
      },
      "description": {
        "en": "A user starts or resumes an audiobook or a podcast episode.",
        "fr": "Un utilisateur lance ou reprend un livre audio ou un épisode de podcast.",
        "de": "Ein Benutzer startet oder setzt ein Hörbuch oder eine Podcast-Episode fort.",
        "es": "Un usuario inicia o reanuda un audiolibro o un episodio de pódcast."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "User (empty: any)",
            "fr": "Utilisateur (vide : n'importe lequel)",
            "de": "Benutzer (leer: beliebig)",
            "es": "Usuario (vacío: cualquiera)"
          }
        },
        {
          "key": "media_type",
          "type": "select",
          "label": {
            "en": "Type (empty: both)",
            "fr": "Type (vide : les deux)",
            "de": "Typ (leer: beide)",
            "es": "Tipo (vacío: ambos)"
          },
          "options": [
            {
              "value": "book",
              "label": {
                "en": "Audiobook",
                "fr": "Livre audio",
                "de": "Hörbuch",
                "es": "Audiolibro"
              }
            },
            {
              "value": "podcast",
              "label": {
                "en": "Podcast episode",
                "fr": "Épisode de podcast",
                "de": "Podcast-Episode",
                "es": "Episodio de pódcast"
              }
            }
          ]
        }
      ],
