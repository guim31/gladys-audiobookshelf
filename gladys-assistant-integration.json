  "scene_actions": [
    {
      "key": "check_new_episodes",
      "label": {
        "en": "Check for new podcast episodes",
        "fr": "Chercher de nouveaux épisodes de podcast",
        "de": "Nach neuen Podcast-Episoden suchen",
        "es": "Buscar nuevos episodios de pódcast"
      },
      "description": {
        "en": "Audiobookshelf reads the feed of every podcast and downloads the new episodes.",
        "fr": "Audiobookshelf lit le flux de chaque podcast et télécharge les nouveaux épisodes.",
        "de": "Audiobookshelf liest den Feed jedes Podcasts und lädt die neuen Episoden herunter.",
        "es": "Audiobookshelf lee el feed de cada pódcast y descarga los episodios nuevos."
      },
      "timeout_seconds": 120,
